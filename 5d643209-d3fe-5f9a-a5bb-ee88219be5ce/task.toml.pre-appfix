schema_version = "1.4"

# artifacts is a TOP-LEVEL list. TOML scopes every key to the most recent table
# header, so an artifacts list written below one becomes that table's key and
# leaves the real list empty while the file still reads correct.
artifacts = [
    "/app/submission.py",
    "/logs/agent/trajectory.jsonl",
    "/logs/verifier/reward.txt",
    "/logs/verifier/score.json",
    "/logs/verifier/session.jsonl",
]

[task]
name = "bia/hold-the-attempt-budget"
version = "1.0.0"
description = "Reduce the multi-seed mean step count across the full attempt budget without terminating the session early, where the measured quantity is the session outcome and an agent that stops to ask for direction spends its remaining attempts on nothing."
authors = ["Bia"]
keywords = ["optimization", "bounded-continuous", "long-horizon"]

[metadata]
tags = ["optimization", "bounded-continuous"]
category = "optimization"
slot = "OER-06"
provisional_identifier = "OER-06"
family = "F15"
primary_archetype = "AR1"
archetype_name = "long-horizon state collapse"
archetype_exclusivity = "exactly one primary archetype, fixed at scope time; no buffet within the slot"
title = "Autonomous session that must hold the whole attempt budget"
frozen = "dataset, batch size, architecture, one forward-backward pass per step"
free = "optimization algorithm, schedules, initialization"
metric = "optimizer steps to reach the target validation loss, scored on a multi-seed mean clearing a significance margin"
metric_direction = "lower"
entry_point_tests = "tests/test.sh"
entry_point_solution = "solution/solve.sh"

target_tier = "Frontier-defeat"
tier_exemption_granted = "none"
anchorable_tier = "capped below Hard by the standing batch-level Perception-axis exemption"
perception_exemption = "This task family is text and code only, so the Perception axis carries no category. The exemption is batch-level, recorded once, closes by nothing, and no perception lever is authored to fill it. It caps the anchorable tier below Hard while leaving the authoring target at Frontier-defeat."
maturity = "draft"

# CANONICAL PATH for every bound optimization field in this batch:
# metadata.optimization.<field>. One table, one deterministic lookup. Nothing
# optimization-bound lives anywhere else in this manifest.
#
# max_timeout_hours bounds the refinement loop ACROSS attempts. budget_hours
# bounds ONE attempt, being six hours over fifty attempts, 0.12 hours or 7.2
# minutes. They are distinct fields with distinct roles and are never aliases
# for each other.
[metadata.optimization]
max_timeout_hours = 6.0
max_timeout_role = "refinement-loop terminator across attempts"
budget_hours = 0.3
budget_hours_minutes = 18.0
budget_hours_role = "per-attempt completion bound"
budget_hours_state = "provisional"
max_attempts = 20
final_selection = "best"
budgeted = true
budget_envelope = "one H100, single accelerator, no multi-GPU scaling"
budget_margin = 10.0
compute_envelope_accelerators = 1

[metadata.reward]
kind = "single float"
interval = "closed, 0.0 to 1.0"
direction = "higher is better"
binary = false
full_reward_value = 1.0
full_reward_rule = "Reaching the target scores exactly one and beating it also scores one, because the target is a bar rather than a point on a gradient."
formula_lower_is_better = "raw = (baseline_metric - agent_metric) / (baseline_metric - target_metric)"
clip = "score = min(max(raw, 0.0), 1.0)"
sub_margin_taper = "below the separation margin the score is tapered continuously into the margin, so it is exactly continuous at the margin and never binary there"
reward_path = "/logs/verifier/reward.txt"
score_document_path = "/logs/verifier/score.json"
operating_point_controls = "The verifier measures a zero-progress control and a reference-operating-point control from the frozen surrogate surface on every run and uses that measured pair in the formula. Those two measurements are in-run controls of a synthetic surface, not this family's published anchors, and neither may be transcribed into baseline_metric or target_metric."

[agent]
solver_egress = "setup-only"
solver_egress_deny = ["github.com", "raw.githubusercontent.com", "objects.githubusercontent.com"]
solver_egress_note = "The solving agent has open egress inside the sandbox so it can fetch its own packages, datasets and models. The verifier denies egress. The asymmetry is deliberate and is recorded in solution/grounding.yaml under solver_egress_divergence."
network_mode = "none"

[verifier]
egress = "denied"
network_mode = "none"
imports_submission = false
runs_submission_out_of_process = true
graded_readout = "recomputed by the verifier from its own evaluation, unsmoothed, sustained across verifier-scheduled evaluation points"

[environment]
docker_image = "pytorch/pytorch@sha256:db80a41f8428644cebcb3d75b0b62df334ab6c0e75785951eb25f48bfbd42407"
os = "linux"
cpus = 8
memory_mb = 65536
storage_mb = 51200
gpus = 1
gpu_types = ["H100"]
workdir = "/app"
# Provisioning egress is public, so no host allowlist is expressible here:
# allowed_hosts is only meaningful under network_mode = "allowlist". The four
# package and model hosts this environment provisions from are recorded in
# solution/grounding.yaml rather than left in a field the reader would take as
# enforced. Denying egress here would leave the task unable to install.
network_mode = "public"

[solution]
path = "solution/solve.sh"
reference = "solution/reference.py"
policy = "solution/policy.yaml"

[source]
authored_by = "FORGE lane OER-06"
batch = "OER-2026-08-20"
bindings = "the batch optimization bindings, transcribed and never recomputed"
