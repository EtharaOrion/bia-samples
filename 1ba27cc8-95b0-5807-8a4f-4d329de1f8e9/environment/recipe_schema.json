{
  "schema": "bia.recipe/v1",
  "note": "The closed key set of a recipe. The free axes of this task are the optimization algorithm, its schedules and the initialization, and they are expressed here. A key outside `fields` is dropped and recorded as an unknown key. A key inside `frozen_axis_keys` is refused and recorded as a frozen-axis write, which is a graded failure.",
  "fields": {
    "optimizer": {
      "type": "enum",
      "values": [
        "sgd",
        "momentum",
        "nesterov",
        "adam",
        "adamw",
        "lion",
        "ortho_momentum"
      ],
      "default": "momentum"
    },
    "lr": {
      "type": "float",
      "min": 1e-06,
      "max": 1.0,
      "default": 0.005
    },
    "beta1": {
      "type": "float",
      "min": 0.0,
      "max": 0.999,
      "default": 0.9
    },
    "beta2": {
      "type": "float",
      "min": 0.0,
      "max": 0.9999,
      "default": 0.95
    },
    "eps": {
      "type": "float",
      "min": 1e-12,
      "max": 0.001,
      "default": 1e-08
    },
    "weight_decay": {
      "type": "float",
      "min": 0.0,
      "max": 0.5,
      "default": 0.0
    },
    "schedule": {
      "type": "enum",
      "values": [
        "constant",
        "linear_decay",
        "cosine",
        "wsd",
        "inverse_sqrt"
      ],
      "default": "constant"
    },
    "warmup_frac": {
      "type": "float",
      "min": 0.0,
      "max": 0.5,
      "default": 0.0
    },
    "decay_frac": {
      "type": "float",
      "min": 0.0,
      "max": 1.0,
      "default": 0.2
    },
    "final_lr_frac": {
      "type": "float",
      "min": 0.0,
      "max": 1.0,
      "default": 0.0
    },
    "grad_clip": {
      "type": "float",
      "min": 0.001,
      "max": 100.0,
      "default": 1.0
    },
    "ns_steps": {
      "type": "int",
      "min": 1,
      "max": 10,
      "default": 5
    },
    "embed_lr_mult": {
      "type": "float",
      "min": 0.01,
      "max": 64.0,
      "default": 1.0
    },
    "head_lr_mult": {
      "type": "float",
      "min": 0.01,
      "max": 64.0,
      "default": 1.0
    },
    "init_scheme": {
      "type": "enum",
      "values": [
        "normal",
        "scaled_normal",
        "orthogonal"
      ],
      "default": "normal"
    },
    "init_scale": {
      "type": "float",
      "min": 0.01,
      "max": 4.0,
      "default": 1.0
    },
    "max_steps": {
      "type": "int",
      "min": 1,
      "max": null,
      "default": null,
      "max_from_shape": "max_steps",
      "note": "the training length this attempt runs. Halting before a crossing has completed its sustain window is an early stop and is graded as no crossing."
    }
  },
  "proposal_fields": {
    "recipe": {
      "type": "object",
      "required": true
    },
    "summary_digest": {
      "type": "string",
      "required": true,
      "note": "echo of the summary_digest in the state.json this attempt was handed"
    },
    "inherits_from": {
      "type": "list[int]",
      "required": false,
      "default": []
    },
    "report": {
      "type": "object",
      "required": false,
      "note": "recorded, never graded. Fields: crossing_step, claimed_val_loss, readout."
    }
  },
  "frozen_axis_keys": [
    "vocab_size",
    "num_layers",
    "model_dim",
    "head_dim",
    "seq_len",
    "batch_tokens_per_step",
    "forward_passes_per_step",
    "backward_passes_per_step",
    "grad_accum",
    "micro_steps",
    "dataset",
    "train_shards",
    "data_seed_train",
    "data_seed_val",
    "stream_tokens_train",
    "target_loss",
    "eval_stride",
    "sustain_window"
  ]
}
